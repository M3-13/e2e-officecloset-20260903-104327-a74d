# Copy this file to `.env` and adjust, or export these variables in your shell.
# The office runner (RUN.json) rolls JWT_SECRET per run; set it yourself for
# local development so issued tokens stay valid across restarts.
# Generate a fresh one with:  python -c "import secrets; print(secrets.token_hex(32))"

JWT_SECRET=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./backend/data/app.db
UPLOAD_DIR=./backend/uploads
FRONTEND_ORIGIN=http://localhost:5173
JWT_EXPIRES_MINUTES=60
